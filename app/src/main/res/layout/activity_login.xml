<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal"
    android:background="#F8F9FA">

    <View android:layout_width="0dp" android:layout_height="60dp" />

    <!-- Avatar tròn chữ B -->
    <TextView
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:background="@drawable/circle_bg"
        android:text="B"
        android:textColor="#FFFFFF"
        android:textSize="48sp"
        android:textStyle="bold"
        android:gravity="center" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Thư viện sách"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#212529"
        android:layout_marginTop="20dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Đăng nhập để tiếp tục"
        android:textColor="#6C757D"
        android:textSize="14sp"
        android:layout_marginTop="4dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tên đăng nhập"
        android:textStyle="bold"
        android:textColor="#333333"
        android:layout_marginTop="32dp" />

    <EditText
        android:id="@+id/etUsername"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="Nhập tên đăng nhập"
        android:inputType="text"
        android:imeOptions="actionNext"
        android:background="@android:drawable/editbox_background"
        android:paddingStart="12dp"
        android:singleLine="true" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Mật khẩu"
        android:textStyle="bold"
        android:textColor="#333333"
        android:layout_marginTop="16dp" />

    <EditText
        android:id="@+id/etPassword"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="••••••"
        android:inputType="textPassword"
        android:imeOptions="actionDone"
        android:background="@android:drawable/editbox_background"
        android:paddingStart="12dp"
        android:singleLine="true" />

    <TextView
        android:id="@+id/tvError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#DC3545"
        android:textSize="13sp"
        android:layout_marginTop="6dp"
        android:visibility="gone"
        android:text="Sai tên đăng nhập hoặc mật khẩu" />

    <Button
        android:id="@+id/btnLogin"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Đăng nhập"
        android:textSize="16sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#00695C"
        android:layout_marginTop="20dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tài khoản mẫu: admin / 123456"
        android:textColor="#888888"
        android:textSize="13sp"
        android:layout_marginTop="16dp" />
</LinearLayout>